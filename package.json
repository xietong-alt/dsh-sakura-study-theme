{
  "name": "dsh-sakura-study-theme",
  "version": "1.2.0",
  "private": true,
  "description": "DeepSeek Harness 动态背景与深色玻璃主题，支持动图和 4 秒内视频",
  "type": "module",
  "license": "MIT",
  "author": "xietong-alt",
  "repository": { "type": "git", "url": "https://github.com/xietong-alt/dsh-sakura-study-theme.git" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "icon.svg", "locale/*.json", "assets/wallpaper.*", "styles/*.css", "src/runtime.mjs", "theme.config.json", "scripts/*.mjs", "skills/**", "README.md", "LICENSE", "ASSET_LICENSE.md", "THIRD_PARTY_LICENSES.txt"],
  "scripts": { "build": "node scripts/build-theme.mjs", "test": "node --test tests/*.test.mjs" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-layout"] } }
}
